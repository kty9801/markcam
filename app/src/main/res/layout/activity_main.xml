<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.nixy.markcam.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상단 버튼 -->
    <TextView
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/pill"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="⚙  설정"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnFlip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/pill"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="⟲  전환"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 셔터 -->
    <View
        android:id="@+id/shutter"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/shutter"
        android:clickable="true"
        android:focusable="true" />

    <!-- 설정 패널 -->
    <ScrollView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_bg"
        android:maxHeight="520dp"
        android:paddingHorizontal="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="26dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="워터마크 설정"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="14dp" />

            <TextView style="@style/PanelLabel" android:text="메모 (현장명 등)" />
            <EditText
                android:id="@+id/memo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:hint="예) 난곡로 현장 점검"
                android:textColorHint="#88FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:inputType="text"
                android:maxLines="1" />

            <CheckBox android:id="@+id/cbDate" style="@style/PanelCheck" android:text="날짜 · 시간 표시" />
            <CheckBox android:id="@+id/cbAddr" style="@style/PanelCheck" android:text="주소 표시" />
            <CheckBox android:id="@+id/cbCoord" style="@style/PanelCheck" android:text="좌표 표시" />

            <TextView style="@style/PanelLabel" android:text="글자 크기" android:paddingTop="12dp" />
            <SeekBar
                android:id="@+id/sbSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView style="@style/PanelLabel" android:text="강조 색" android:paddingTop="8dp" />
            <LinearLayout
                android:id="@+id/accentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="6dp" />

            <TextView style="@style/PanelLabel" android:text="표시 위치" android:paddingTop="8dp" />
            <LinearLayout
                android:id="@+id/posRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/pill"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:text="완료"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
